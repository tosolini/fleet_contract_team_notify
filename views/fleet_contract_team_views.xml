<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="fleet_contract_team_view_list" model="ir.ui.view">
        <field name="name">fleet.contract.team.list</field>
        <field name="model">fleet.contract.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="contract_count" string="Contracts"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="fleet_contract_team_view_form" model="ir.ui.view">
        <field name="name">fleet.contract.team.form</field>
        <field name="model">fleet.contract.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contracts" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-file-text">
                            <field name="contract_count" widget="statinfo" string="Contracts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active"/>
                    <group>
                        <field name="name" placeholder="e.g. Maintenance Team" string="Team Name"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Users to Notify">
                        <field name="user_ids" widget="many2many_tags" 
                               options="{'color_field': 'color', 'no_create': True}"
                               placeholder="Select users who will receive notifications..."
                               nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="fleet_contract_team_view_search" model="ir.ui.view">
        <field name="name">fleet.contract.team.search</field>
        <field name="model">fleet.contract.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_active" string="Status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="fleet_contract_team_action" model="ir.actions.act_window">
        <field name="name">Contract Teams</field>
        <field name="res_model">fleet.contract.team</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Notification Team
            </p>
            <p>
                Teams allow you to notify multiple people simultaneously
                when there are deadlines or important events on fleet contracts.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="fleet_contract_team_menu"
              name="Contract Teams"
              parent="fleet.fleet_configuration"
              action="fleet_contract_team_action"
              sequence="50"/>
</odoo>
