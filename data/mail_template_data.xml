<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Email Template for Contract Expiry with Multiple CC -->
        <record id="mail_template_contract_expiry" model="mail.template">
            <field name="name">Fleet Contract Team Notify - Contract Expiry</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="subject">Contract Expiry: ${object.vehicle_id.display_name} - ${object.cost_subtype_id.name or 'Contract'}</field>
            <field name="email_from">${(object.company_id.email or user.email_formatted) | safe}</field>
            <field name="email_to">${object.user_id.email or ''}</field>
            <field name="email_cc">${','.join(object.notify_user_ids.filtered(lambda u: u.email).mapped('email'))}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear ${object.user_id.name or 'User'},
                        <br/><br/>
                        The contract <strong>${object.cost_subtype_id.name or 'Contract'}</strong> 
                        for vehicle <strong>${object.vehicle_id.display_name}</strong> 
                        is about to expire.
                        <br/><br/>
                        <strong>Details:</strong><br/>
                        • Vehicle: ${object.vehicle_id.display_name}<br/>
                        • Contract Type: ${object.cost_subtype_id.name}<br/>
                        • Expiry Date: ${format_date(object.expiration_date)}<br/>
                        % if object.start_date:
                        • Start Date: ${format_date(object.start_date)}<br/>
                        % endif
                        % if object.cost_generated:
                        • Cost: ${object.cost_generated} ${object.currency_id.symbol}<br/>
                        % endif
                        % if object.insurer_id:
                        • Provider: ${object.insurer_id.name}<br/>
                        % endif
                        <br/>
                        % if object.notes:
                        <strong>Notes:</strong><br/>
                        ${object.notes | safe}
                        <br/><br/>
                        % endif
                        % if object.team_id:
                        <em>Assigned Team: ${object.team_id.name}</em><br/>
                        % endif
                        <br/>
                        <div style="margin: 16px 0px 16px 0px;">
                            <a href="/web#id=${object.id}&amp;view_type=form&amp;model=fleet.vehicle.log.contract" 
                               style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                                View Contract
                            </a>
                        </div>
                        <br/>
                        Best regards,<br/>
                        ${object.company_id.name}
                    </p>
                </div>
            </field>
            <field name="lang">${object.user_id.lang}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Email Template for New Contract Notification -->
        <record id="mail_template_contract_notification" model="mail.template">
            <field name="name">Fleet Contract Team Notify - New Contract</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="subject">New Contract Assigned: ${object.vehicle_id.display_name}</field>
            <field name="email_from">${(object.company_id.email or user.email_formatted) | safe}</field>
            <field name="email_to">${','.join(object.notify_user_ids.filtered(lambda u: u.email).mapped('email'))}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi,
                        <br/><br/>
                        A new contract has been created for vehicle <strong>${object.vehicle_id.display_name}</strong>
                        and your team <strong>${object.team_id.name}</strong> has been assigned for notifications.
                        <br/><br/>
                        <strong>Details:</strong><br/>
                        • Vehicle: ${object.vehicle_id.display_name}<br/>
                        • Contract Type: ${object.cost_subtype_id.name}<br/>
                        % if object.start_date:
                        • Start Date: ${format_date(object.start_date)}<br/>
                        % endif
                        % if object.expiration_date:
                        • Expiry Date: ${format_date(object.expiration_date)}<br/>
                        % endif
                        % if object.cost_generated:
                        • Cost: ${object.cost_generated} ${object.currency_id.symbol}<br/>
                        % endif
                        <br/>
                        <div style="margin: 16px 0px 16px 0px;">
                            <a href="/web#id=${object.id}&amp;view_type=form&amp;model=fleet.vehicle.log.contract" 
                               style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                                View Contract
                            </a>
                        </div>
                        <br/>
                        ${object.company_id.name}
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
