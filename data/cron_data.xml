<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron per notifiche scadenze contratti (giornaliero) -->
        <record id="ir_cron_fleet_contract_expiry_notify" model="ir.cron">
            <field name="name">Fleet: Notifica Scadenze Contratti Team</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_expiring_contracts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>

        <!-- Cron per reminder urgente a 7 giorni dalla scadenza -->
        <record id="ir_cron_fleet_contract_expiry_urgent" model="ir.cron">
            <field name="name">Fleet: Reminder Urgente Scadenze (7 giorni)</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle_log_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_notify_expiring_contracts(days=7, template_xmlid='fleet_contract_team_notify.mail_template_contract_expiry_urgent')</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_admin"/>
        </record>
    </data>
</odoo>
